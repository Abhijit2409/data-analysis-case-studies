# Copy this file to .streamlit/secrets.toml and fill in a real key.
# .streamlit/secrets.toml is git-ignored and must never be committed.
#
# The application works fully WITHOUT a key. Only the written answers on the
# "Ask the analysis" page need one; without it that page returns the matching
# passages from the project's own files instead.
#
# API use may incur charges on the account that owns the key.

OPENAI_API_KEY = "sk-REPLACE-WITH-YOUR-OWN-KEY"

# Optional. Defaults to gpt-6-luna, OpenAI's efficient model for focused,
# high-volume tasks, which suits grounded question answering over a small
# evidence pack. Alternatives include gpt-6.1-sol and gpt-6-astra at higher cost.
# OPENAI_MODEL = "gpt-6-luna"
